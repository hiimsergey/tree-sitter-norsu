{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "norsu",
      "camelcase": "Norsu",
      "title": "Norsu",
      "scope": "source.norsu",
      "file-types": [
        "no",
        "norsu"
      ],
      "injection-regex": "^norsu$",
      "class-name": "TreeSitterNorsu"
    }
  ],
  "metadata": {
