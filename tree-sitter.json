    "license": "GPL-3.0",
    "description": "A modern markup language designed for personal knowledge management",
    "authors": [
      {
        "name": "Sergey Lavrent",
        "email": "sergeylavrent@protonmail.com",
        "url": "https://github.com/hiimsergey"
      }
    ],
    "links": {
      "repository": "https://github.com/hiimsergey/tree-sitter-norsu"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
